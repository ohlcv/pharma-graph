{
  "name": "pharma-graph",
  "version": "0.1.0",
  "description": "Knowledge graph for pharmaceutical science",
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "audit": "tsx scripts/audit-frontmatter.ts",
    "measure-overlap": "tsx scripts/measure-overlap.ts",
    "dev": "bash scripts/dev.sh",
    "preview": "vite preview",
    "start": "npm run dev",
    "view": "node --import tsx scripts/serve.ts",
    "build:graph": "vite-node scripts/build-graph-data.ts",
    "build:manifest": "vite-node scripts/build-content-manifest.ts",
    "prebuild": "npm run build:graph && npm run build:manifest && npm run validate:graph",
    "build": "vite build",
    "check:graph": "vite-node scripts/check-graph-fresh.ts",
    "validate:graph": "vite-node scripts/validate-graph-data.ts --validate",
    "validate:graph:deep": "vite-node scripts/validate-graph-deep.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "cytoscape": "^3.34.0",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.13",
    "glob": "^11.0.0",
    "marked": "^18.0.9",
    "regenerator-runtime": "^0.14.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.19.21",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-euler": "^1.2.4",
    "cytoscape-popper": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "terser": "^5.51.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^2.1.9"
  }
}
