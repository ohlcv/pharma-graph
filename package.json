{
  "name": "pharma-graph",
  "version": "0.1.0",
  "description": "Knowledge graph for pharmaceutical science",
  "type": "module",
  "scripts": {
    "validate": "tsx src/scripts/validate.ts",
    "audit": "tsx src/scripts/audit-frontmatter.ts",
    "dev": "vite",
    "preview": "vite preview",
    "start": "npm run dev",
    "view": "node --import tsx src/scripts/serve.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "glob": "^11.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^2.1.9",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-euler": "^1.2.4",
    "cytoscape-popper": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vite": "^8.0.16",
    "vitest": "^2.1.9"
  }
}
